    {
      "id": "domain-lookalike",
      "subject_kind": "domain",
      "value": "metamask-login.help",
      "malicious": true,
      "expected_codes": [
        "SG-DOM-004",
        "SG-IMP-001"
      ],
      "min_severity": "high"
    },
    {
      "id": "domain-punycode",
      "subject_kind": "domain",
      "value": "xn--pple-43d.com",
      "malicious": true,
